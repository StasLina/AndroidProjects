<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mapFragment">

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.maproutebuilder.fragments.MapFragment"
        android:label="MapFragment"
        tools:layout="@layout/fragment_map">
            <action
            android:id="@+id/action_mapFragment_to_routeBuilderFragment"
            app:destination="@id/routeBuilderFragment" />
    </fragment>

    <fragment
        android:id="@+id/routeBuilderFragment"
        android:name="com.example.maproutebuilder.fragments.RouteBuilderFragment"
        android:label="RouteBuilderFragment"
        tools:layout="@layout/fragment_route_builder" />
</navigation>