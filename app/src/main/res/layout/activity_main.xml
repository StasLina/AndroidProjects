<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:layout_margin="20dp">

    <EditText
        android:id="@+id/SearchingTown"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/BFindTown"
        android:layout_marginEnd="8dp"
        android:hint="Введите город"/>

    <Button
        android:id="@+id/BFindTown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/SearchingTown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/SearchingTown"
        android:text="Найти" />
    <TextView
        android:id="@+id/ChooseTown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="Выбранный город: Москва"
        app:layout_constraintTop_toBottomOf="@id/SearchingTown"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ViewSwitch" />

        <TextView
            android:id="@+id/ViewSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Цельсий / Фаренгейт"
            android:textAlignment="center"
            app:layout_constraintTop_toBottomOf="@id/SearchingTown"
            app:layout_constraintStart_toEndOf="@id/ChooseTown"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Switch
            android:id="@+id/temperatureSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/ViewSwitch"
            app:layout_constraintEnd_toEndOf="@id/ViewSwitch"
            app:layout_constraintTop_toBottomOf="@+id/ViewSwitch"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/r_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/ChooseTown"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>