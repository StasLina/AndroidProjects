<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="20dp">

    <!-- Заголовок "Профиль" -->
    <TextView
        android:id="@+id/Top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:text="Профиль"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="20dp" />

    <!-- Подпись для Login -->
    <TextView
        android:id="@+id/labelLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login:"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/Top"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Значение Login -->
    <TextView
        android:id="@+id/valueLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="user123"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/labelLogin"
        app:layout_constraintStart_toEndOf="@id/labelLogin"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp" />

    <!-- Подпись для Login Name -->
    <TextView
        android:id="@+id/labelLoginName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login Name:"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/labelLogin"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Значение Login Name -->
    <TextView
        android:id="@+id/valueLoginName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="empty"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/labelLoginName"
        app:layout_constraintStart_toEndOf="@id/labelLoginName"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp" />

    <!-- Подпись для Following Count -->
    <TextView
        android:id="@+id/labelFollowingCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Following Count:"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/labelLoginName"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Значение Following Count -->
    <TextView
        android:id="@+id/valueFollowingCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/labelFollowingCount"
        app:layout_constraintStart_toEndOf="@id/labelFollowingCount"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp" />

    <!-- Подпись для Description -->
    <TextView
        android:id="@+id/labelDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Description:"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/labelFollowingCount"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Значение Description -->
    <TextView
        android:id="@+id/valueDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="This is a sample description."
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/labelDescription"
        app:layout_constraintStart_toEndOf="@id/labelDescription"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>